<?xml version="1.0" encoding="UTF-8"?>
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="com.openexchange.core.infrastructure.orderjournal.generated"
                   id="5"
                   version="1"
                   semanticVersion="0.1"
                   description="core order journal schema: one record per order event, recorded per member as a replayable Aeron Archive stream (4102). journalSeq equals the core eventSeq (dense, starts at 1). The head (journalSeq at 0, epoch at 8, a log position at 16) mirrors the ME journal head so one frame peek serves both. Bytes 24..174 are bytes 16..166 of the money-schema OrderEvent body (template 102), written by the same codec; enum-typed fields carry the money-schema codes as uint8. Every value comes from the log entry that produced the event, so the record is identical on every member and on every replay."
>
    <types>
        <composite name="messageHeader" description="Message identifiers and length of message root">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId" primitiveType="uint16"/>
            <type name="version" primitiveType="uint16"/>
        </composite>
    </types>

    <sbe:message name="OrderJournalEvent" id="1" description="One order event. liquidity: 0 NONE, 1 TAKER, 2 MAKER (set on a FILL with tradeId above 0; TAKER when orderId is the trade's takerOmsOrderId, MAKER when it is the makerOmsOrderId). meEpoch, meJournalSeq, meLogPosition (the ME record's egressSeq) and meTimestampMs name the ME record whose apply emitted the event and are 0 when the event is not ME-caused.">
        <field name="journalSeq"        id="1"  type="int64"/>
        <field name="epoch"             id="2"  type="int64" description="the recorded CoreConfig genesisId"/>
        <field name="logPosition"       id="3"  type="int64" description="the core log position of the applying entry"/>
        <field name="orderId"           id="4"  type="int64"/>
        <field name="userId"            id="5"  type="int64"/>
        <field name="marketId"          id="6"  type="int32"/>
        <field name="eventKind"         id="7"  type="uint8" description="money-schema EventKind code"/>
        <field name="status"            id="8"  type="uint8" description="money-schema OrderStatus code"/>
        <field name="reason"            id="9"  type="uint8" description="money-schema CoreRejectReason code"/>
        <field name="side"              id="10" type="uint8" description="money-schema Side code"/>
        <field name="orderType"         id="11" type="uint8" description="money-schema OrderType code"/>
        <field name="timeInForce"       id="12" type="uint8" description="money-schema TimeInForce code"/>
        <field name="price"             id="13" type="int64"/>
        <field name="stopPrice"         id="14" type="int64"/>
        <field name="quantity"          id="15" type="int64"/>
        <field name="filledQty"         id="16" type="int64"/>
        <field name="remainingQty"      id="17" type="int64"/>
        <field name="lastPrice"         id="18" type="int64"/>
        <field name="lastQty"           id="19" type="int64"/>
        <field name="tradeId"           id="20" type="int64"/>
        <field name="meOrderId"         id="21" type="int64"/>
        <field name="holdAssetId"       id="22" type="int32"/>
        <field name="holdAmount"        id="23" type="int64"/>
        <field name="holdRemaining"     id="24" type="int64"/>
        <field name="clientOrderIdHigh" id="25" type="int64"/>
        <field name="clientOrderIdLow"  id="26" type="int64"/>
        <field name="createdAtMs"       id="27" type="int64"/>
        <field name="updatedAtMs"       id="28" type="int64"/>
        <field name="meReason"          id="29" type="uint8"/>
        <field name="liquidity"         id="30" type="uint8"/>
        <field name="meEpoch"           id="31" type="int64"/>
        <field name="meJournalSeq"      id="32" type="int64"/>
        <field name="meLogPosition"     id="33" type="int64"/>
        <field name="meTimestampMs"     id="34" type="int64"/>
    </sbe:message>
</sbe:messageSchema>
