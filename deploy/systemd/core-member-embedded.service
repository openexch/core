#
# One core cluster member per host, embedded media driver (dev and demo only; prod runs core-member.service with
# the host aeronmd). The same env files as core-member.service; the two units conflict.

[Unit]
Description=Open Exchange core member (embedded media driver)
Documentation=https://github.com/openexch/core/tree/main/deploy
After=network-online.target
Wants=network-online.target
Conflicts=core-member.service
# The restart backoff paces a crash loop; a burst counter would park the unit for good.
StartLimitIntervalSec=0

[Service]
Environment=BASE_DIR=/var/lib/openexchange/core
EnvironmentFile=/etc/openexchange/core/cluster.env
EnvironmentFile=/etc/openexchange/core/member.env
EnvironmentFile=-/etc/openexchange/core/host.env
EnvironmentFile=/etc/openexchange/core/secrets.env
StateDirectory=openexchange/core
StateDirectoryMode=0750
Type=simple
User=openexchange
Group=openexchange
ExecStart=/opt/openexchange/core/bin/core-launch member embedded
Restart=on-failure
RestartSec=2s
RestartSteps=6
RestartMaxDelaySec=60s
RestartPreventExitStatus=78
SuccessExitStatus=143
TimeoutStopSec=30s
LimitNOFILE=65536
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
