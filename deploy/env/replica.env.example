# /etc/openexchange/core-replica/replica.env: the replica's own settings (its host also carries the members'
# cluster.env). At stride 0 the replica has its own host; any slot is free of the members' ports there.
CLUSTER_REPLICA_SLOT=3
# The address the members reach the replica on.
CLUSTER_REPLICA_ADDRESS=core-replica.example.internal
# The replica's HTTP endpoint is computed: CLUSTER_PORT_BASE + CLUSTER_REPLICA_SLOT * CLUSTER_PORT_STRIDE + 6.
# Optional explicit override, accepted only when it equals that number:
#CORE_NODE_PORT=9306
