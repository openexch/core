# /etc/openexchange/core/secrets.env, owner root:root, mode 0600. systemd reads it before dropping privileges.
# Members: the key table, the same on every member: keyId:CLASS:secretHex:identity:users=... entries, ';' separated.
CORE_AUTH_KEYS=
# The replica (core-replica/secrets.env): its own credential, keyId:REPLICA:secretHex.
#CORE_AUTH_CREDENTIAL=
