# /etc/openexchange/core/cluster.env: the same file on every member host and on the replica host.
# Every name here is read by core-cluster.jar; the engine refuses a malformed value at boot.

# The members' addresses in member-id order (host names or IPs, one per member).
CLUSTER_ADDRESSES=core-0.example.internal,core-1.example.internal,core-2.example.internal
# Ports: base + id * stride + offset (offsets 1..5 UDP: archive control, client, member, log, transfer; 6 the node
# HTTP endpoint /health, /ready, /metrics). Stride 0: one member per host, every host on the same ports.
CLUSTER_PORT_BASE=9300
CLUSTER_PORT_STRIDE=0

# Optional transport settings (engine defaults when unset):
#TRANSPORT_IDLE_MODE=backoff
#TRANSPORT_LOG_TERM_LENGTH=64m
#TRANSPORT_TERM_LENGTH=16m
#TRANSPORT_SNAPSHOT_TERM_LENGTH=8m
#TRANSPORT_CONSENSUS_TERM_LENGTH=1m
#TRANSPORT_EXTERNAL_DRIVER_TIMEOUT_MS=30000
