# /etc/openexchange/core/member.env: the only file that differs between member hosts.
CLUSTER_NODE=0
# The node HTTP endpoint (/health, /ready, /metrics) is computed by the engine:
# CLUSTER_PORT_BASE + CLUSTER_NODE * CLUSTER_PORT_STRIDE + 6 (9306 at base 9300, stride 0).
# Optional explicit override: accepted only when it equals that number, any other value refuses the boot.
#CORE_NODE_PORT=9306
