<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.openexchange.core</groupId>
        <artifactId>core</artifactId>
        <version>0.1.0-runtime.20260928.r02d.g571248f</version>
    </parent>

    <artifactId>core-bridge</artifactId>
    <packaging>jar</packaging>
    <properties>
        <!-- Overridden by the build with the short git sha. See the shade plugin's
             Build-Sha manifest entry for why this is never guessed. -->
        <buildSha>unknown</buildSha>
    </properties>
    <name>Core Client Tools</name>
    <description>Core cluster client tools: the read-only ledger dump of the money check and the
        set-money-journal command. The settlement bridge is the C++ ct-bridge (cluster-tools).</description>

    <dependencies>
        <!-- Internal: money value objects + SBE wire codecs (Settle, TerminalRelease, ...) -->
        <dependency>
            <groupId>com.openexchange.core</groupId>
            <artifactId>core-common</artifactId>
        </dependency>

        <!-- Aeron (client to the core cluster) -->
        <!-- The cluster port arithmetic: one copy, shared with the engines and OMS. -->
        <dependency>
            <groupId>com.openexchange</groupId>
            <artifactId>cluster-kit</artifactId>
        </dependency>

        <dependency>
            <groupId>io.aeron</groupId>
            <artifactId>aeron-all</artifactId>
        </dependency>

        <!-- Testing -->
        <!-- Test-scoped: the dump tests boot a real in-process core cluster. -->
        <dependency>
            <groupId>com.openexchange.core</groupId>
            <artifactId>core-cluster</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
            <!-- Uber JAR for the client tools -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>core-bridge</finalName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.openexchange.core.bridge.BridgeMain</mainClass>
                                    <!-- Aeron/Agrona need these opens on JDK 17+; baking them into the
                                         manifest lets `java -jar core-bridge.jar dump` (the money-check
                                         CoreDump CLI) run without repeating the flags on the command line. -->
                                    <manifestEntries>
                                        <Add-Opens>java.base/jdk.internal.misc java.base/sun.nio.ch java.base/java.nio</Add-Opens>
                                        <!-- Stamped so a published result names the exact
                                             binary that produced it. The default is the literal
                                             "unknown" rather than a guess, so a build without
                                             provenance says so instead of implying it. -->
                                        <Build-Sha>${buildSha}</Build-Sha>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
