# Behaviour 4: the create path looks its requestId up first, so a retried create always gets its stored decision. The
# same log as create_retry_after_gate_closed_v3 one behaviour step later: with the gate closed, the retry of the
# accepted create (rid 1) is acked as a duplicate of order 1 and the retry of the stored reject (rid 2) replays
# INSUFFICIENT_FUNDS; neither is GATE_CLOSED. A first-time create under the closed gate (rid 3) is still GATE_CLOSED
# and stores nothing, so it is admitted once the gate reopens. One order and one hold exist for rid 1 throughout.
CLOCK 1700000000000
V3GENESIS behavior=4
GATE market=0 open=1
DEPOSIT u=1 asset=0 amt=100000.0
CREATE u=1 market=1 side=0 type=0 px=100.0 qty=1.0 rid=1 corr=11       # accepted: order 1
CREATE u=1 market=1 side=0 type=0 px=100.0 qty=5000.0 rid=2 corr=12    # INSUFFICIENT_FUNDS, stored
GATE market=0 open=0                                                    # ADMIN closes the global gate
CREATE u=1 market=1 side=0 type=0 px=100.0 qty=1.0 rid=1 corr=13       # retry of the acceptance: duplicate ack, order 1
CREATE u=1 market=1 side=0 type=0 px=100.0 qty=5000.0 rid=2 corr=14    # retry of the stored reject: INSUFFICIENT_FUNDS
CREATE u=1 market=1 side=0 type=0 px=100.0 qty=1.0 rid=3 corr=15       # first time: GATE_CLOSED, not stored
SNAPSHOT
CREATE u=1 market=1 side=0 type=0 px=100.0 qty=1.0 rid=1 corr=16       # the same after a restore
GATE market=0 open=1
CREATE u=1 market=1 side=0 type=0 px=100.0 qty=1.0 rid=1 corr=17       # duplicate ack, order 1
CREATE u=1 market=1 side=0 type=0 px=100.0 qty=5000.0 rid=2 corr=18    # the stored INSUFFICIENT_FUNDS
CREATE u=1 market=1 side=0 type=0 px=100.0 qty=1.0 rid=3 corr=19       # rid 3 was never stored: order 2
