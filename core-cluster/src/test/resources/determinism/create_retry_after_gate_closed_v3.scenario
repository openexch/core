# Behaviour 3 control for the create retry: the requestId lookup runs after the gate, so a create that was accepted
# (rid 1) or refused with a stored reject (rid 2) and is retried while the gate is closed is answered GATE_CLOSED, not
# with its stored decision. A first-time create under the closed gate (rid 3) is GATE_CLOSED and stores nothing. A
# snapshot changes none of it. Once the gate reopens the stored decisions answer again. This file is the recorded
# behaviour 3 log: its golden must never change.
CLOCK 1700000000000
V3GENESIS
GATE market=0 open=1
DEPOSIT u=1 asset=0 amt=100000.0
CREATE u=1 market=1 side=0 type=0 px=100.0 qty=1.0 rid=1 corr=11       # accepted: order 1
CREATE u=1 market=1 side=0 type=0 px=100.0 qty=5000.0 rid=2 corr=12    # INSUFFICIENT_FUNDS, stored
GATE market=0 open=0                                                    # ADMIN closes the global gate
CREATE u=1 market=1 side=0 type=0 px=100.0 qty=1.0 rid=1 corr=13       # retry of the acceptance: GATE_CLOSED
CREATE u=1 market=1 side=0 type=0 px=100.0 qty=5000.0 rid=2 corr=14    # retry of the stored reject: GATE_CLOSED
CREATE u=1 market=1 side=0 type=0 px=100.0 qty=1.0 rid=3 corr=15       # first time: GATE_CLOSED, not stored
SNAPSHOT
CREATE u=1 market=1 side=0 type=0 px=100.0 qty=1.0 rid=1 corr=16       # the same after a restore
GATE market=0 open=1
CREATE u=1 market=1 side=0 type=0 px=100.0 qty=1.0 rid=1 corr=17       # duplicate ack, order 1
CREATE u=1 market=1 side=0 type=0 px=100.0 qty=5000.0 rid=2 corr=18    # the stored INSUFFICIENT_FUNDS
CREATE u=1 market=1 side=0 type=0 px=100.0 qty=1.0 rid=3 corr=19       # rid 3 was never stored: order 2
